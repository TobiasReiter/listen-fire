import { `@lf/gmail` as gmail, `@lf/attio` as attio, `@lf/slack` as slack } from adapters
import { `Dev Loop Gmail` as gmailCred, `Dev Loop Attio` as attioCred, `Dev Loop Slack` as slackCred } from credentials

mail = connect gmail using gmailCred
crm  = connect attio using attioCred
chat = connect slack using slackCred

node Pitch: "the startup pitching us in this email" {
  company: <text> "the startup's name"
  raise:   <text | null> "what they are raising, e.g. $3M seed"
  summary: <text> "what the startup does, in one sentence"
}

function `Founder Intake`(msg: <mail-[:Message]->>) {
  address = coalesce(Text.regexExtract(msg.From, "<(.+)>", 1), msg.From)
  founder = Text.trim(Text.regexExtract(msg.From, "^([^<]+)<", 1))
  domain  = Text.regexExtract(address, "@(.+)$", 1)
  pitch   = extractOne([msg.Body], Pitch, { tier: "quick" })
  if (pitch == null) { fail("no pitch found in ${msg.Subject}") }
  raise   = coalesce(pitch.raise, "raise not stated")

  company = write crm-[:Companies]-> {
    Name:        pitch.company
    Domains:     [domain]
    Description: pitch.summary
  }
  write company-[:Team]-> {
    Name:  founder
    Email: address
  }
  write company-[:`VC Deal Flow`]-> { Stage: "Sourced" }
  write company-[:Notes]-> { Title: msg.Subject, Content: msg.`Plain Body` }

  chat-[ch:Channels WHERE ch.Name == "dealflow"]-> {
    write ch-[:Messages]-> { Message: "New inbound: ${pitch.company}, ${raise}, from ${founder}" }
  }
}

listen to mail { events: ["message_received"], labels: ["Dealflow"] } fire `Founder Intake`
