{
  "name": "lf-cli",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "description": "Test harness for the `lf` binary (crates/lf-host): drives the built binary against the example project. Contains no lf runtime.",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "node --conditions=movement-engine-internals --test --require tsx/cjs src/__test__/*.test.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "engine-contracts": "workspace:*",
    "module-kit": "workspace:*",
    "movement-engine": "workspace:*",
    "tsx": "4.21.0",
    "yaml": "2.5.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.5.4"
  }
}
