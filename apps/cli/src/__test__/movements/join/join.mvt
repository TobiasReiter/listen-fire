import { acme_crm } from adapters
import { acme } from credentials

crm = connect acme_crm using acme

# Two arms wait, an hour and two; what each returns is used after the join.
function both(company: <crm-[:Company]->>) {
  r = all(() => {
    await sleep(1h)
    return "early"
  }, () => {
    await sleep(2h)
    return "late"
  })
  early = r[0]
  late = r[1]
  write crm-[:Company]-> { Name: "${early} ${late} ${company.Name}" }
}

listen to crm {} fire both
