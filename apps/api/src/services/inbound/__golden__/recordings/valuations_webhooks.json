    "id": "register-invalid-event-type",
    "door": "valuations_webhooks",
    "note": "An event type outside the valuations shape is 400 with the issue tree.",
    "request": {
      "method": "POST",
      "path": "/api/v1/valuations/webhooks",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"url\":\"https://hooks.subscriber.test/valuations\",\"eventTypes\":[\"attio:record:create\"]}"
    },
    "response": {
      "status": 400,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "177"
      },
      "body": "{\"error\":\"invalid_body\",\"issues\":{\"_errors\":[],\"eventTypes\":{\"0\":{\"_errors\":[\"Invalid string: must match pattern /^valuations:[a-z_]+:(create|update|delete)$/\"]},\"_errors\":[]}}}"
    },
    "effects": []
