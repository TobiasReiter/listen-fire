  {
    "id": "interactive-reply-fires-callback",
    "door": "whatsapp",
    "note": "A tapped reply button with a callback id fires it and replies from the receiving number.",
    "request": {
      "method": "POST",
      "path": "/api/public/whatsapp/webhook",
      "headers": {
        "content-type": "application/json",
        "x-hub-signature-256": "sha256=dad94d64229ce9405d73fdf935602acb3f70a06b0894517395306cf1b1501ef1"
      },
      "body": "{\"object\":\"whatsapp_business_account\",\"entry\":[{\"id\":\"waba-1\",\"changes\":[{\"field\":\"messages\",\"value\":{\"metadata\":{\"phone_number_id\":\"pn-1\"},\"messages\":[{\"from\":\"15550002222\",\"id\":\"wamid.11\",\"timestamp\":\"1760702400\",\"type\":\"interactive\",\"interactive\":{\"type\":\"button_reply\",\"button_reply\":{\"id\":\"cb_golden0001\",\"title\":\"Approve\"}}}]}}]}]}"
    },
    "response": {
      "status": 200,
      "headers": {
        "content-type": "text/html; charset=utf-8",
        "content-length": "14"
      },
      "body": "EVENT_RECEIVED"
    },
    "effects": [
      {
        "kind": "fire_callback",
        "id": "cb_golden0001",
        "values": {}
      },
      {
        "kind": "whatsapp_send_text",
        "businessPhoneNumberId": "pn-1",
        "to": "15550002222",
        "text": "Thanks — that has been recorded.",
        "options": {
          "replyToMessageId": "wamid.11"
        }
      },
      {
        "kind": "ops_notification",
        "type": "OVI",
        "teamId": "team-1",
        "text": ":speech_balloon: New WhatsApp message from: Ada (15550002222)\n*Message*: \"Interactive Button: Approve (cb_golden0001)\"",
        "opsTitle": "New WhatsApp message from Ada"
      },
      {
        "kind": "whatsapp_dispatch_message",
        "message": {
          "from": "15550002222",
          "id": "wamid.11",
          "timestamp": "1760702400",
          "type": "interactive",
          "interactive": {
            "type": "button_reply",
            "button_reply": {
              "id": "cb_golden0001",
              "title": "Approve"
            }
          }
        },
        "businessPhoneNumberId": "pn-1"
      }
    ]
  },
