      "method": "POST",
      "path": "/api/public/adapter/acme-crm/emit",
      "headers": {
        "content-type": "application/json",
        "x-listen-fire-adapter-secret": "not-the-secret"
      },
      "body": "{\"events\":[{\"eventType\":\"record.created\",\"externalId\":\"r-1\",\"payload\":{\"id\":\"r-1\"}}]}"
    },
    "response": {
      "status": 401,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "24"
      },
      "body": "{\"error\":\"unauthorized\"}"
    },
    "effects": []
  },
