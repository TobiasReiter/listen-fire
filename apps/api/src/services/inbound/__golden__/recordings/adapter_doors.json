[
  {
    "id": "emit-good-credential",
    "door": "adapter_doors",
    "note": "The presented credential names the install and so the team; events are receipted against its triggers and queued; 202 with the count.",
    "request": {
      "method": "POST",
      "path": "/api/public/adapter/acme-crm/emit",
      "headers": {
        "content-type": "application/json",
        "x-listen-fire-adapter-secret": "golden-adapter-door-secret-0001"
      },
      "body": "{\"events\":[{\"eventType\":\"record.created\",\"externalId\":\"r-1\",\"payload\":{\"id\":\"r-1\"}}]}"
    },
    "response": {
      "status": 202,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "14"
      },
      "body": "{\"accepted\":1}"
    },
    "effects": [
      {
        "kind": "find_triggers",
        "teamId": "aaaaaaaa-0000-4000-8000-000000000001",
        "kinds": [
          "ACME-CRM",
          "acme-crm"
        ]
      },
      {
        "kind": "capture_receipt",
        "triggerId": "trigger-1",
        "movementId": "movement-1",
        "teamId": "aaaaaaaa-0000-4000-8000-000000000001",
        "adapterType": "acme-crm",
        "triggerType": "webhook",
        "event": {
          "payload": {
            "id": "r-1"
          },
          "externalId": "r-1",
          "eventType": "record.created"
        }
      },
      {
        "kind": "enqueue_receipts",
        "receipts": [
          {
            "receiptId": "receipt-trigger-1"
          }
        ]
      },
      {
        "kind": "notify_work"
      }
    ]
  },
  {
    "id": "emit-bearer-strategy",
    "door": "adapter_doors",
    "note": "An install whose strategy is bearer sends the credential as Authorization.",
    "request": {
      "method": "POST",
      "path": "/api/public/adapter/acme-crm/emit",
      "headers": {
        "authorization": "Bearer golden-adapter-door-secret-0001",
        "content-type": "application/json"
      },
      "body": "{\"events\":[{\"eventType\":\"record.created\",\"externalId\":\"r-1\",\"payload\":{\"id\":\"r-1\"}}]}"
    },
    "response": {
      "status": 202,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "14"
      },
      "body": "{\"accepted\":0}"
    },
    "effects": [
      {
        "kind": "find_triggers",
        "teamId": "aaaaaaaa-0000-4000-8000-000000000001",
        "kinds": [
          "ACME-CRM",
          "acme-crm"
        ]
      },
      {
        "kind": "enqueue_receipts",
        "receipts": []
      }
    ]
  },
  {
