[
  {
    "id": "message-from-linked-sender",
    "door": "telegram_shared",
    "note": "Right secret: the update is handed over, its work rows queued before the 200, the drain poked after.",
    "request": {
      "method": "POST",
      "path": "/api/public/telegram/builtin",
      "headers": {
        "content-type": "application/json",
        "x-telegram-bot-api-secret-token": "golden-telegram-shared-secret-0001"
      },
      "body": "{\"update_id\":10,\"message\":{\"message_id\":5,\"text\":\"hello\",\"chat\":{\"id\":9},\"from\":{\"id\":3}}}"
    },
    "response": {
      "status": 200,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "65"
      },
      "body": "{\"ok\":true,\"classification\":\"message\",\"routedTeamIds\":[\"team-1\"]}"
    },
    "effects": [
      {
        "kind": "telegram_shared_bot_inbound",
        "raw": {
          "update_id": 10,
          "message": {
            "message_id": 5,
            "text": "hello",
            "chat": {
              "id": 9
            },
            "from": {
              "id": 3
            }
          }
        }
      },
      {
        "kind": "enqueue_shared_bot_rows"
      },
      {
        "kind": "notify_work"
      }
    ]
  },
  {
