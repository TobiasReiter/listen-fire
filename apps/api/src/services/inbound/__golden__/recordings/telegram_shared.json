  {
    "id": "invalid-json",
    "door": "telegram_shared",
    "note": "A body that is not JSON is 400 invalid_json, before the secret is read.",
    "request": {
      "method": "POST",
      "path": "/api/public/telegram/builtin",
      "headers": {
        "content-type": "application/json",
        "x-telegram-bot-api-secret-token": "golden-telegram-shared-secret-0001"
      },
      "body": "{not json"
    },
    "response": {
      "status": 400,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "35"
      },
      "body": "{\"ok\":false,\"error\":\"invalid_json\"}"
    },
    "effects": []
  },
  {
    "id": "non-json-content-type",
    "door": "telegram_shared",
    "note": "A non-JSON content type is not read raw; the handler gets the empty object express leaves.",
    "request": {
      "method": "POST",
      "path": "/api/public/telegram/builtin",
      "headers": {
        "content-type": "text/plain",
        "x-telegram-bot-api-secret-token": "golden-telegram-shared-secret-0001"
      },
      "body": "x"
    },
    "response": {
      "status": 200,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "41"
      },
      "body": "{\"ok\":true,\"classification\":\"no_message\"}"
    },
    "effects": [
      {
        "kind": "telegram_shared_bot_inbound",
        "raw": {}
      },
      {
        "kind": "notify_work"
      }
    ]
  },
  {
    "id": "callback-query-answered-inline",
    "door": "telegram_shared",
    "note": "A button tap is settled wholly before the ack; the body carries the callback outcome.",
    "request": {
      "method": "POST",
      "path": "/api/public/telegram/builtin",
      "headers": {
        "content-type": "application/json",
        "x-telegram-bot-api-secret-token": "golden-telegram-shared-secret-0001"
      },
      "body": "{\"update_id\":11,\"callback_query\":{\"id\":\"cbq-9\",\"data\":\"cb_golden0001\",\"message\":{\"message_id\":11,\"chat\":{\"id\":9}}}}"
    },
    "response": {
      "status": 200,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "94"
      },
      "body": "{\"ok\":true,\"classification\":\"callback_query\",\"callback\":{\"handled\":true,\"outcome\":\"recorded\"}}"
    },
    "effects": [
      {
        "kind": "telegram_shared_bot_inbound",
        "raw": {
          "update_id": 11,
          "callback_query": {
            "id": "cbq-9",
            "data": "cb_golden0001",
            "message": {
              "message_id": 11,
              "chat": {
                "id": 9
              }
            }
          }
        }
      },
      {
        "kind": "notify_work"
      }
    ]
  },
