generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "multiSchema", "postgresqlExtensions", "views", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext(schema: "public"), vector]
  schemas    = ["asks", "automations", "core", "knowledge", "public", "valuations"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Ask {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId               String               @map("team_id") @db.Uuid
  family               String
  answerType           String?              @map("answer_type")
  prompt               String
  detail               String?
  options              Json?
  rows                 Json?
  state                String               @default("open")
  answer               Json?
  token                String               @unique(map: "ask_token_unique")
  tokenExpiresAt       DateTime             @map("token_expires_at") @db.Timestamptz(6)
  provenance           Json                 @default("{}")
  callbackUrl          String?              @map("callback_url")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  answeredAt           DateTime?            @map("answered_at") @db.Timestamptz(6)
  expiredAt            DateTime?            @map("expired_at") @db.Timestamptz(6)
  askWebhookDeliveries AskWebhookDelivery[]

  @@index([state])
  @@index([teamId])
  @@map("ask")
  @@schema("asks")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AskWebhookDelivery {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  askId         String    @map("ask_id") @db.Uuid
  url           String
  attempt       Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  status        String    @default("pending")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  ask           Ask       @relation(fields: [askId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([askId])
  @@map("ask_webhook_delivery")
  @@schema("asks")
}

model AsksWorkerHeartbeat {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker        String    @unique(map: "asks_worker_heartbeat_worker_idx")
  lastBeatAt    DateTime  @default(now()) @map("last_beat_at") @db.Timestamptz(6)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  detail        Json?

  @@map("worker_heartbeat")
  @@schema("asks")
}

model AdapterAwait {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adapterType    String     @map("adapter_type")
  correlationKey String     @map("correlation_key")
  runId          String     @map("run_id") @db.Uuid
  teamId         String     @map("team_id") @db.Uuid
  address        String
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  triggerRun     TriggerRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, address], map: "adapter_await_run_address_unique")
  @@index([adapterType, correlationKey, teamId], map: "adapter_await_correlation_idx")
  @@index([runId])
  @@map("adapter_await")
  @@schema("automations")
}

model AutomationsAuditLog {
  id        String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy String?                            @map("created_by")
  createdAt DateTime                           @default(now()) @map("created_at")
  version   BigInt                             @default(autoincrement())
  modelId   String?                            @map("model_id") @db.Uuid
  teamId    String?                            @map("team_id") @db.Uuid
  contextId String?                            @map("context_id") @db.Uuid
  op        AutomationsNativeDatabaseOperation
  tableName String                             @map("table_name")
  old       Json?
  new       Json?

  @@index([contextId], map: "automations_audit_log_context_id_idx")
  @@index([createdAt], map: "automations_audit_log_created_at_idx")
  @@index([modelId], map: "automations_audit_log_model_id_idx")
  @@index([version], map: "automations_audit_log_version_idx")
  @@map("audit_log")
  @@schema("automations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Callback {
  id         String     @id
  teamId     String     @map("team_id") @db.Uuid
  runId      String     @map("run_id") @db.Uuid
  address    String
  params     Json       @default("[]")
  state      Json
  calls      Json       @default("[]")
  singleUse  Boolean    @default(true) @map("single_use")
  expiresAt  DateTime?  @map("expires_at") @db.Timestamptz(6)
  status     String     @default("live")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  firedAt    DateTime?  @map("fired_at") @db.Timestamptz(6)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)
  triggerRun TriggerRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([teamId])
  @@map("callback")
  @@schema("automations")
}

