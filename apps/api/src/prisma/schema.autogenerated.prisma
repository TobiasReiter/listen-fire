/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Movement {
  id                                                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId                                                   String               @map("team_id") @db.Uuid
  name                                                     String
  source                                                   String
  description                                              String               @default("")
  triggerId                                                String?              @map("trigger_id") @db.Uuid
  currentVersionId                                         String?              @map("current_version_id") @db.Uuid
  createdByUserId                                          String?              @map("created_by_user_id") @db.Uuid
  validityStatus                                           String?              @map("validity_status")
  validityReason                                           Json?                @map("validity_reason")
  validitySourceHash                                       String?              @map("validity_source_hash")
  validityCheckedAt                                        DateTime?            @map("validity_checked_at") @db.Timestamptz(6)
  validityConsentedAt                                      DateTime?            @map("validity_consented_at") @db.Timestamptz(6)
  createdAt                                                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  validityCheckedAgainst                                   Int?                 @map("validity_checked_against")
  languageVersion                                          Int                  @default(1) @map("language_version")
  upgradeDiagnostics                                       Json?                @map("upgrade_diagnostics")
  upgradeCheckedAgainst                                    Int?                 @map("upgrade_checked_against")
  movementVersionMovementCurrentVersionIdTomovementVersion MovementVersion?     @relation("movement_current_version_idTomovement_version", fields: [currentVersionId], references: [id])
  triggerMovementTriggerIdTotrigger                        Trigger?             @relation("movement_trigger_idTotrigger", fields: [triggerId], references: [id])
  movementIssues                                           MovementIssue[]
  movementStoryTokens                                      MovementStoryToken[]
  movementVersionMovementVersionMovementIdTomovements      MovementVersion[]    @relation("movement_version_movement_idTomovement")
  triggerTriggerMovementIdTomovements                      Trigger[]            @relation("trigger_movement_idTomovement")

  @@unique([teamId, name], map: "movement_team_name_unique")
  @@index([teamId])
  @@map("movement")
  @@schema("automations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
