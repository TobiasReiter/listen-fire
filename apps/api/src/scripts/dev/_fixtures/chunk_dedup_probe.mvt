import { manual, slack } from adapters
import { `Dev Loop Slack` } from credentials

runs = connect manual
chat = connect slack using `Dev Loop Slack`

# A local node declaration (piece 1 of the four under verification): a
# structure this file owns, with no address anywhere in a real system. Its
# landings are typed by this shape, not by an adapter's schema.
node Company {
  name: <text>
  website: <text>
}

# Verifies, end to end, on synthetic content only (Acme / Actions / Faction /
# Example Ventures — no real companies or people):
#   (a) CHUNKS cuts the pasted text into pieces small enough to force >= 3
#   (b) extract reads every piece — a list-typed `from` slot flattens into
#       one extraction call over N text segments, no MAP/closure needed
#       (MAP(pieces, (p) => { extract from [p] {...} }) also checks and
#       runs, and DOES fan out one model call per piece, if that per-call
#       isolation is ever wanted instead)
#   (c) each extracted company is deduplicated into `deduped` by FUZZY name
#   (d) the deduplicated list is read back and posted as the run's result
node FoundShape: "the relevant information in the content" {
  node company: "each company named in this piece of text" {
    name: <text> "the company's name"
    website: <text> "the company's website, if the text gives one"
  }
}

function chunk_dedup_probe(go: <runs-[:Invocation]->>) {
  deduped = node { companies: <Company> }

  pieces = Text.chunks(go.`Text`, { size: 110, overlap: 15 })

  found = extractOne([...pieces], FoundShape)

  if (found != null) {
    found-[c:company]-> {
      write deduped-[:companies]-> {
        unique by (FUZZY name)
        name: c.`name`
        website ?: c.`website`
      }
    }
  }

  names = List.from(deduped-[c:companies ORDER BY c.`name`]->.`name`)
  summary = Text.join(names, ", ")

  chat-[ch:Channels WHERE ch.`Name` == "general"]-> {
    write ch-[:Messages]-> { Message: "Deduplicated companies: ${summary}" }
  }
}

listen to runs {} fire chunk_dedup_probe
