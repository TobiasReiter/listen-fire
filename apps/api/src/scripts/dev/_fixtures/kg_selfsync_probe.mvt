import { kg } from adapters
import { `Dev Loop Knowledge` } from credentials

graph = connect kg using `Dev Loop Knowledge`

function kg_selfsync_probe(change: <graph-[:`Record Change` WHERE `type` == "Organisation" AND `action` == "record.created"]->>) {
  change-[org:Record]-> {
    write graph-[:Organisation]-> {
      Name: org.Name
      Sector: "Synced"
    }
  }
}

listen to graph { type: "Organisation", events: ["record.created"], suppress_self: true } fire kg_selfsync_probe
