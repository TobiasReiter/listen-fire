import { manual, slack } from adapters
import { `Dev Loop Slack` } from credentials

runs = connect manual
chat = connect slack using `Dev Loop Slack`

# Verifies READ + CHUNKS over the SAME file-extraction seam `extract from [
# … .`File`]` already uses: reuses the born-digital attachment
# `verify_file_extraction_e2e_seed.ts` seeds on the fake Slack `general`
# channel, but reads it explicitly (`READ(f.`File`)`) and cuts it
# (`CHUNKS(…, { size: 120, overlap: 20 })`) before extracting, instead of
# handing the raw file straight to `extract from [ … ]`. Confirms both new
# built-ins' trace entries (`read`, `chunks`) appear on the run alongside the
# extraction's own trace, and that extraction still emits off the cut text.
node FoundShape: "the relevant information in the content" {
  node company: "each company named in this piece of text" {
    name: <text> "the company's name"
    stage: <text> "the funding round or stage the document names, if any"
  }
}

function read_chunks_probe(go: <runs-[:Invocation]->>) {
  chat-[ch:Channels WHERE ch.`Name` == "general"]-> {
    ch-[m:Messages]-> {
      m-[f:Files]-> {
        pieces = Text.chunks(File.read(f.`File`), { size: 120, overlap: 20 })

        found = extractOne([...pieces], FoundShape)

        if (found != null) {
          found-[c:company]-> {
            write m-[:Replies]-> { Message ?: c.`name` }
          }
        }
      }
    }
  }
}

listen to runs {} fire read_chunks_probe
