{
  "name": "@lf/affinity",
  "license": "Apache-2.0",
  "version": "0.11.0",
  "description": "Affinity (organizations, people, opportunities, lists, notes, files) as a module: read, written, and signed webhooks. Loaded in process by the platform, served by serve-module everywhere else. Its tests borrow apps/api's jest runner (jest.config.borrowed.cjs)",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "node ../../apps/api/node_modules/jest/bin/jest.js --config jest.config.borrowed.cjs",
    "prepack": "node ../../scripts/build-packages.cjs ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "type": "commonjs",
  "dependencies": {
    "@lf/engine": "workspace:^",
    "@lf/engine-contracts": "workspace:^",
    "@lf/module-kit": "workspace:^",
    "@lf/movement-lang": "workspace:^",
    "@lf/shared": "workspace:^",
    "date-fns": "3.6.0",
    "exponential-backoff": "3.1.1",
    "lodash": "4.17.21",
    "tldts": "6.1.44",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "#shared": "workspace:@lf/shared@*",
    "@types/jest": "29.5.14",
    "@types/lodash": "4.17.7",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@lf/engine-contracts@*",
    "module-kit": "workspace:@lf/module-kit@*",
    "movement-engine": "workspace:@lf/engine@*",
    "movement-lang": "workspace:@lf/movement-lang@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/affinity"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    }
  }
}
