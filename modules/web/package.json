{
  "name": "@lf/web",
  "license": "Apache-2.0",
  "version": "0.11.0",
  "description": "The six bundled plugins (fetch a page, scan a message for links worth fetching, find a person's profile, read what they are doing now, find a company's own site, research a subject) as one plugin module. Loaded in process by the platform with its own tools, served by serve-module everywhere else with the standalone tools (Anthropic, Bright Data, a plain fetch). Its tests borrow apps/api's jest runner (jest.config.borrowed.cjs)",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "node ../../apps/api/node_modules/jest/bin/jest.js --config jest.config.borrowed.cjs",
    "bench": "node --require ../../packages/module-kit/node_modules/tsx/dist/cjs/index.cjs bench/hosted_bench.ts",
    "prepack": "node ../../scripts/build-packages.cjs ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "type": "commonjs",
  "dependencies": {
    "@lf/engine": "workspace:^",
    "@lf/engine-contracts": "workspace:^",
    "@lf/file-text": "workspace:^",
    "@lf/module-kit": "workspace:^",
    "@lf/movement-lang": "workspace:^",
    "@lf/shared": "workspace:^",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "#shared": "workspace:@lf/shared@*",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@lf/engine-contracts@*",
    "file-text": "workspace:@lf/file-text@*",
    "module-kit": "workspace:@lf/module-kit@*",
    "movement-engine": "workspace:@lf/engine@*",
    "movement-lang": "workspace:@lf/movement-lang@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/web"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    }
  }
}
