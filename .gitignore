# Dev loop transient state (CLI conversation IDs, logs)
.dev-loop/

# Obsidian
.obsidian/

# SQLite transient state (write-ahead log + shared memory)
*.db-wal
*.db-shm

# Brainstorming visual-companion mockups (local only)
.superpowers/

# Next.js generated type shim (regenerated on build)
next-env.d.ts

apps/chrome-extension/dist/

# The standalone story bundle — emitted from packages/story-view by the API's
# build (and on demand: `pnpm --filter story-view bundle`), never pinned.
apps/api/public/story/

# The parser artifact, copied from packages/movement-lang/wasm by
# apps/web/next.config.ts on every `next dev` / `next build`.
apps/web/public/movement_parser.*.wasm

# Fake-channels dev-loop store (recreated by seedDefaults on boot)
apps/fake-channels/test-harness-data/fake-channels.db

# Local health-check stamp (regenerated by apps/api/scripts/health-check.sh)
HEALTH.md

# Rust build output (the parser crate)
/target

# The publishable packages' builds (scripts/build-packages.cjs), packed, never committed
packages/*/dist/
modules/*/dist/
package.json.unpacked
/site/
