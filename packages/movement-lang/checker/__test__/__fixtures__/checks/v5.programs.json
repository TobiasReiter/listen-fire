{"program":"cfc5b85038e89bda4631e866527619a0d508964792ec448aad854874af1a6fe5","source":"import { email, attio } from adapters\nimport { dealflow_inbox, acme_main } from credentials\ninbox = connect email using dealflow_inbox\ncrm   = connect attio using acme_main\nfunction m(msg: <inbox-[:message]->>) {\n  iso = DateTime.toIso(msg.`text`)\n  later = msg.`text` > \"March 8, 2026 1:45 AM\"\n  if (later) {\n    day = Date.from(msg.`text`)\n  }\n}"}
{"program":"d48628311a188b2d68ec40ee95030f384b558a4c7638471662d8797cf8952b5e","source":"import { email, attio } from adapters\nimport { dealflow_inbox, acme_main } from credentials\ninbox = connect email using dealflow_inbox\ncrm   = connect attio using acme_main\nfunction m(msg: <inbox-[:message]->>) {\n  pin = @current_timestamp\n  if (pin != DateTime.from(\"2026-07-15T11:00:00.000Z\")) {\n    bad = Date.addDays(\"2026-01-01\", 1000000000)\n  }\n}"}
