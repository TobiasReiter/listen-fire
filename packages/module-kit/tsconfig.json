{
  "compilerOptions": {
    "lib": ["es2022", "DOM"],
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "exclude": ["node_modules", "jest.config.borrowed.cjs"]
}
