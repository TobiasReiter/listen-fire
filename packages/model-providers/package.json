{
  "name": "@listen-fire/model-providers",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.1",
  "description": "The model vendors behind the engine's chat, embedding, image and transcription seams (OpenAI, Gemini, Claude on Vertex, Anthropic). The vendor SDKs are optional peers loaded on first use; the environment and the two host answers (usage recording, token counting) are passed in, never read from the process. Its tests borrow apps/api's jest runner (jest.config.borrowed.cjs)",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "node ../../apps/api/node_modules/jest/bin/jest.js --config jest.config.borrowed.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/engine": "workspace:^",
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@anthropic-ai/vertex-sdk": "^0.19.9",
    "@google/genai": "^2.24.0",
    "openai": "5.22.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@anthropic-ai/vertex-sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@anthropic-ai/vertex-sdk": "^0.19.9",
    "@google/genai": "^2.24.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "openai": "5.22.0",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/model-providers"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    },
    "tag": "next"
  }
}
